{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "key": " ",
      "type": "title",
    },
    {
      "key": "╔═══════════╗",
      "type": "custom",
    },
    {
      "key": "║ {#31}󰣇 distro  {#keys}║",
      "type": "os",
    },
    {
      "key": "║ {#32} vendor  {#keys}║",
      "type": "host",
      "format": "{vendor}",
    },
    {
      "key": "║ {#33}󰌢 machine {#keys}║",
      "type": "host",
      "format": "{name}",
    },
    {
      "key": "║ {#34} kernel  {#keys}║",
      "type": "kernel",
    },
    {
      "key": "║ {#35}󰏗 package {#keys}║",
      "type": "packages",
    },
    {
      "key": "║ {#31} shell   {#keys}║",
      "type": "shell",
    },
    {
      "key": "║ {#32} session {#keys}║",
      "type": "wm",
    },
    {
      "key": "║ {#33} term    {#keys}║",
      "type": "terminal",
    },
    {
      "key": "║ {#34}󰍛 cpu     {#keys}║",
      "type": "cpu",
    },
    {
      "key": "║ {#35}󰊴 gpu     {#keys}║",
      "type": "gpu",
    },
    {
      "key": "║ {#31} memory  {#keys}║",
      "type": "memory",
    },
    {
      "key": "║ {#32}󰉉 disk    {#keys}║",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "║ {#33}󰍹 display {#keys}║",
      "type": "display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
    },
    {
      "key": "║ {#34}󰅐 uptime  {#keys}║",
      "type": "uptime",
    },
    {
      "key": "║ {#35}󰁹 battery {#keys}║",
      "type": "battery",
      "format": "{capacity} [{status}]",
    },
    {
      "key": "╠═══════════╣",
      "type": "custom",
    },
    {
      "key": "║ {#39} colors  {#keys}║",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╚═══════════╝",
      "type": "custom",
    },
  ],
}
